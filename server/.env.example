# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# The port of the API
PORT=5000

# MongoDB Atlas connection string. The database name ("assessai") is the part after the host.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assessai?retryWrites=true&w=majority

# The address of the Next.js client (used for CORS and trusted origins)
CLIENT_URL=http://localhost:3000

# BetterAuth: a long random text (at least 32 characters) and the address of this API
BETTER_AUTH_SECRET=change-me-to-a-long-random-text-of-32-characters-or-more
BETTER_AUTH_URL=http://localhost:5000

# Google sign-in (optional for the demo, email and password login works without it).
# Callback URL to register in Google Cloud: http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional. The text models are tried in this order, and the embedding model is used for the course search.
# GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768